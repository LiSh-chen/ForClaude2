# 複製為 .env.local 後填入。請勿提交任何真實金鑰。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/review_butler
USE_MOCK_ADAPTERS=true
# 32 bytes，base64 編碼。產生方式：openssl rand -base64 32
ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LIFF_ID=

ANTHROPIC_API_KEY=
# 分類用小模型、撰寫用大模型，模型名稱請填入你帳號可用的 model ID
LLM_MODEL_CLASSIFY=
LLM_MODEL_WRITE=

ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_INVOICE_MERCHANT_ID=
ECPAY_INVOICE_HASH_KEY=
ECPAY_INVOICE_HASH_IV=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GEO_CHECK_DAILY_BUDGET_USD=

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
SENTRY_DSN=
APP_BASE_URL=http://localhost:3000
