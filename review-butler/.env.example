# 複製為 .env.local 後填入。請勿提交任何真實金鑰。
# 不填 DATABASE_URL 時，本機會使用 .data/pglite 內嵌資料庫並自動建表，零設定即可啟動
DATABASE_URL=
USE_MOCK_ADAPTERS=true
# 個別覆寫（選填）。階段 1：其他維持 mock、只有 AI 用真的 Claude → USE_MOCK_LLM=false 並填 ANTHROPIC_API_KEY
# USE_MOCK_GOOGLE= / USE_MOCK_LINE= / USE_MOCK_LLM= / USE_MOCK_PAYMENT=
# 登入 session 簽章金鑰。產生方式：openssl rand -base64 32（開發環境可不填）
SESSION_SECRET=
# 32 bytes，base64 編碼。產生方式：openssl rand -base64 32
ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LIFF_ID=
# 官方帳號加好友連結（例如 https://line.me/R/ti/p/@你的ID），顯示在後台 LINE 頁
LINE_ADD_FRIEND_URL=
# 排程入口 /api/jobs/tick 的密鑰（正式環境必填）。Vercel Cron 會帶 Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

ANTHROPIC_API_KEY=
# 分類用小模型、撰寫用大模型；未填時預設 claude-haiku-5-5 / claude-sonnet-5-5
LLM_MODEL_CLASSIFY=
LLM_MODEL_WRITE=

ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_INVOICE_MERCHANT_ID=
ECPAY_INVOICE_HASH_KEY=
ECPAY_INVOICE_HASH_IV=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GEO_CHECK_DAILY_BUDGET_USD=

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
SENTRY_DSN=
APP_BASE_URL=http://localhost:3000
